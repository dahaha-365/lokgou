{
  "$schema": "https://opencode.ai/config.json",
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 10
  },
  "provider": {
    "Cherry-CherryIN": {
      "npm": "@ai-sdk/openai",
      "name": "Cherry-CherryIN",
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY_CHERRYIN}",
        "baseURL": "https://open.cherryin.net/v1"
      },
      "models": {
        "openai/gpt-5.6-luna": {
          "name": "openai/gpt-5.6-luna",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "openai/gpt-5.6-terra": {
          "name": "openai/gpt-5.6-terra",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "openai/gpt-5.6-sol": {
          "name": "openai/gpt-5.6-sol",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "anthropic/claude-sonnet-5": {
          "name": "anthropic/claude-sonnet-5",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "anthropic/claude-opus-5": {
          "name": "anthropic/claude-opus-5",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  }
}
