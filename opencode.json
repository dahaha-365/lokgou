{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Cherry-CherryIN": {
      "npm": "@ai-sdk/openai",
      "name": "Cherry-CherryIN",
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY_CHERRYIN}",
        "baseURL": "https://open.cherryin.net/v1"
      },
      "models": {
        "openai/gpt-5.6-terra": {
          "name": "openai/gpt-5.6-terra",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  }
}