DATABASE_URL="file:./prisma/dev.db"
ADMIN_APP_KEY="replace-with-a-secure-random-value"
JWT_SECRET="replace-with-a-secure-random-value-at-least-32-characters"
# Optional: request header that carries the access token. Defaults to admin-authorization.
# ADMIN_AUTHORIZATION_HEADER="admin-authorization"
# Optional: defaults to "admin", producing routes such as /admin/users.
# ADMIN_PREFIX="admin"
# Optional: local attachment root. Files are stored below YYYY/MM/DD directories.
# ATTACHMENT_STORAGE_PATH="storage/attachments"
# Optional: maximum upload size in bytes. Defaults to 10485760 (10 MiB).
# ATTACHMENT_MAX_SIZE="10485760"
# Optional: comma-separated exact MIME types or major-type wildcards. Defaults to *.
# ATTACHMENT_ALLOWED_MIME_TYPES="image/*,application/pdf"
