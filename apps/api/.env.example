DATABASE_URL="file:./prisma/dev.db"
ADMIN_APP_KEY="replace-with-a-secure-random-value"
JWT_SECRET="replace-with-a-secure-random-value-at-least-32-characters"
# Optional: request header that carries the access token. Defaults to admin-authorization.
# ADMIN_AUTHORIZATION_HEADER="admin-authorization"
# Optional: defaults to "admin", producing routes such as /admin/users.
# ADMIN_PREFIX="admin"
