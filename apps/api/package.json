{
  "name": "@lokgou/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/app.ts",
    "start": "prisma generate --config prisma.config.ts && bun src/app.ts",
    "build": "prisma generate --config prisma.config.ts && bun build src/app.ts --outdir dist --target bun",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "lint": "eslint src prisma.config.ts",
    "test": "bun test",
    "typecheck": "prisma generate --config prisma.config.ts && tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "@elysia/openapi": "^1.3.0",
    "@lokgou/schemas": "workspace:*",
    "@prisma/adapter-libsql": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "elysia": "^1.3.0",
    "prisma": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
